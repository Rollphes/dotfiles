function __pj_inventory
    set -l exception_roots $argv

    if not set -q exception_roots[1]
{{ if eq .chezmoi.os "windows" -}}
        set exception_roots "$USERPROFILE/Documents/UnityProject/av-kaihenkai-v2"
{{ end -}}
    end

    set -l candidates

    if command -q zoxide
        for entry in (zoxide query --list --score 2>/dev/null)
            set -l score (string match -r '^\s*[0-9]+(?:\.[0-9]+)?' -- "$entry" | string trim)
            set -l directory (string replace -r '^\s*[0-9]+(?:\.[0-9]+)?\s+' '' -- "$entry")
            set -l repository (git -C "$directory" rev-parse --show-toplevel 2>/dev/null)

            if test -n "$score" -a -n "$repository"
                set -a candidates (string join \t -- "$score" zoxide "$repository")
            end
        end
    end

    if command -q ghq
        for repository in (ghq list --full-path 2>/dev/null)
            set -a candidates (string join \t -- 0 ghq "$repository")
        end
    end

    if command -q fd
        for root in $exception_roots
            if not test -d "$root"
                continue
            end

            for git_entry in (fd --hidden --no-ignore --type directory --type file --glob .git --prune "$root" 2>/dev/null)
                set -a candidates (string join \t -- 0 exception (path dirname "$git_entry"))
            end
        end
    end

    set -l seen
    for candidate in $candidates
        set -l fields (string split \t -- "$candidate")
        set -l score $fields[1]
        set -l source $fields[2]
        set -l project $fields[3]

        if not test -d "$project"
            continue
        end

        set -l resolved (path resolve "$project" 2>/dev/null)
        if test -z "$resolved"
            continue
        end

        set -l key "$resolved"
        if set -q MSYSTEM
            set key (string lower "$key")
        end

        if contains -- "$key" $seen
            continue
        end

        set -a seen "$key"
        printf '%s\t%s\t%s\n' "$score" "$source" "$resolved"
    end
end

function pj
    if not command -q ghq
        echo 'pj: ghq is not available' >&2
        return 1
    end

    if not command -q fzf
        echo 'pj: fzf is not available' >&2
        return 1
    end

    set -l inventory (__pj_inventory)
    if not set -q inventory[1]
        echo 'pj: no repositories found' >&2
        return 0
    end

    set -l choices
    for item in $inventory
        set -l fields (string split \t -- "$item")
        set -l score $fields[1]
        set -l source $fields[2]
        set -l project $fields[3]
        set -l name (path basename "$project")
        set -l owner (path basename (path dirname "$project"))
        set -l display

        switch $source
            case zoxide
                set display (printf '󰅐 %5s  %s/%s' "$score" "$owner" "$name")
            case ghq
                set display (printf '󰊢     -  %s/%s' "$owner" "$name")
            case exception
                set display (printf '󰉋     -  %s/%s' "$owner" "$name")
        end

        set -a choices "$display\t$project"
    end

    set -l preview_shell (command -s fish)
    if set -q MSYSTEM
        set preview_shell (cygpath -w "$preview_shell")
    end

    set -l selected (printf '%b\n' $choices | fzf \
        --height=80% \
        --layout=reverse \
        --border \
        --no-sort \
        --delimiter='\t' \
        --with-nth=1 \
        --accept-nth=2 \
        --prompt='Project> ' \
        --header='󰅐 zoxide  󰊢 ghq  󰉋 exception' \
        --with-shell="$preview_shell -c" \
        --preview='__pj_preview {2}' \
        --preview-window='right,60%')

    if test $status -ne 0 -o -z "$selected"
        return 0
    end

    if not test -d "$selected"
        echo "pj: repository no longer exists: $selected" >&2
        return 1
    end

    cd "$selected"
end
