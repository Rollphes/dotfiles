function __pj_inventory
    set -l exception_repositories $argv

    if not set -q exception_repositories[1]
{{ if eq .chezmoi.os "windows" -}}
        set exception_repositories "$USERPROFILE/Documents/UnityProject/av-kaihenkai-v2"
{{ end -}}
    end

    set -l candidates

    if command -q ghq
        for repository in (ghq list --full-path 2>/dev/null)
            set -a candidates (string join \t -- ghq "$repository")
        end
    end

    for repository in $exception_repositories
        if test -d "$repository"; and test -e "$repository/.git"
            set -a candidates (string join \t -- exception "$repository")
        end
    end

    set -l inventory_keys
    set -l inventory_sources
    set -l inventory_paths
    for candidate in $candidates
        set -l fields (string split \t -- "$candidate")
        set -l source $fields[1]
        set -l project $fields[2]

        if not test -d "$project"; or not test -e "$project/.git"
            continue
        end

        set -l resolved (path resolve "$project" 2>/dev/null)
        if test -z "$resolved"
            continue
        end

        set -l key "$resolved"
        if set -q MSYSTEM
            set key (string lower "$key")
            set key (string replace -r '^/c/msys64/home/' '/home/' -- "$key")
        end

        if contains -- "$key" $inventory_keys
            continue
        end

        set -a inventory_keys "$key"
        set -a inventory_sources "$source"
        set -a inventory_paths "$resolved"
    end

    set -l ranked_keys
    if command -q zoxide
        for entry in (zoxide query --list --score 2>/dev/null)
            set -l score (string match -r '^\s*[0-9]+(?:\.[0-9]+)?' -- "$entry" | string trim)
            set -l directory (string replace -r '^\s*[0-9]+(?:\.[0-9]+)?\s+' '' -- "$entry")

            if test -z "$score"; or not test -d "$directory"
                continue
            end

            set -l directory_key (path resolve "$directory" 2>/dev/null)
            if test -z "$directory_key"
                continue
            end

            if set -q MSYSTEM
                set directory_key (string lower "$directory_key")
                set directory_key (string replace -r '^/c/msys64/home/' '/home/' -- "$directory_key")
            end

            set -l match_index 0
            set -l match_length 0
            set -l index 1
            for repository_key in $inventory_keys
                set -l repository_prefix "$repository_key/"
                set -l prefix_length (string length "$repository_prefix")
                set -l matches false

                if test "$directory_key" = "$repository_key"
                    set matches true
                else if test (string length "$directory_key") -ge $prefix_length
                    if test (string sub -s 1 -l $prefix_length -- "$directory_key") = "$repository_prefix"
                        set matches true
                    end
                end

                if test "$matches" = true -a (string length "$repository_key") -gt $match_length
                    set match_index $index
                    set match_length (string length "$repository_key")
                end

                set index (math $index + 1)
            end

            if test $match_index -gt 0; and not contains -- "$inventory_keys[$match_index]" $ranked_keys
                set -a ranked_keys "$inventory_keys[$match_index]"
                printf '%s\t%s\t%s\n' "$score" "$inventory_sources[$match_index]" "$inventory_paths[$match_index]"
            end
        end
    end

    set -l index 1
    for repository_key in $inventory_keys
        if not contains -- "$repository_key" $ranked_keys
            printf '0\t%s\t%s\n' "$inventory_sources[$index]" "$inventory_paths[$index]"
        end
        set index (math $index + 1)
    end
end

function pj
    if not command -q ghq
        echo 'pj: ghq is not available' >&2
        return 1
    end

    if not command -q fzf
        echo 'pj: fzf is not available' >&2
        return 1
    end

    set -l inventory (__pj_inventory)
    if not set -q inventory[1]
        echo 'pj: no repositories found' >&2
        return 0
    end

    set -l choices
    for item in $inventory
        set -l fields (string split \t -- "$item")
        set -l score $fields[1]
        set -l source $fields[2]
        set -l project $fields[3]
        set -l name (path basename "$project")
        set -l owner (path basename (path dirname "$project"))
        set -l display

        switch $source
            case ghq
                set display (printf '󰊢 %5s  %s/%s' "$score" "$owner" "$name")
            case exception
                set display (printf '󰉋 %5s  %s/%s' "$score" "$owner" "$name")
        end

        set -a choices "$display\t$project"
    end

    set -l preview_shell (command -s sh)
    if set -q MSYSTEM
        set preview_shell (cygpath -w "$preview_shell")
    end

    set -l selected (printf '%b\n' $choices | fzf \
        --height=80% \
        --layout=reverse \
        --border \
        --no-sort \
        --delimiter='\t' \
        --with-nth=1 \
        --accept-nth=2 \
        --prompt='Project> ' \
        --header='󰊢 ghq  󰉋 exception  score: zoxide frecency  Ctrl+P: preview' \
        --with-shell="$preview_shell -c" \
        --preview='"$XDG_CONFIG_HOME/fish/libexec/pj-preview" {2}' \
        --preview-window='right,60%,hidden' \
        --bind='ctrl-p:toggle-preview')

    if test $status -ne 0 -o -z "$selected"
        return 0
    end

    if not test -d "$selected"
        echo "pj: repository no longer exists: $selected" >&2
        return 1
    end

    cd "$selected"
end
