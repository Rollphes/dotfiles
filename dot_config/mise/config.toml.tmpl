[tools]

# Programming languages
node = "lts"
go = "latest"

# CLI tooling

"aqua:starship/starship" = "latest"
"aqua:carapace-sh/carapace-bin" = "latest"
fd = "latest"
ripgrep = "latest"
ast-grep = "latest"
fzf = "latest"
zoxide = "latest"
"aqua:lsd-rs/lsd" = "latest"
"aqua:sxyazi/yazi" = "latest"
{{ if ne .chezmoi.os "windows" -}}
"aqua:atuinsh/atuin" = "latest"
{{ end -}}
"aqua:babarot/gomi" = "latest"
"aqua:bootandy/dust" = "latest"
"aqua:boyter/scc" = "latest"
"aqua:nektos/act" = "latest"
{{ if eq .chezmoi.os "windows" -}}
"github:aristocratos/btop4win" = "latest"
powershell = "latest"
{{ else if eq .chezmoi.os "linux" -}}
"aqua:aristocratos/btop" = "latest"
{{ end -}}
hunk = "latest"

# CLI tooling

"aqua:cli/cli" = "latest"
ghq = "latest"
{{ if ne (env "GITHUB_ACTIONS") "true" -}}
"cargo:keifu" = "latest"
{{ end -}}

# AI tooling

"github:herdrdev/herdr" = "latest"
"npm:@anthropic-ai/claude-code" = { version = "latest", allow_builds = ["@anthropic-ai/claude-code"] }
"npm:@openai/codex" = "latest"
"npm:backlog.md" = "latest"
"pipx:graphifyy" = "latest"

# Package managers

"pnpm" = "latest"
jq = "latest"
python = "latest"
uv = "latest"

# Web tooling

"npm:wrangler" = "latest"
"aqua:supabase/cli" = "latest"

# Vim / Neovim tooling

neovim = "latest"
"aqua:tree-sitter/tree-sitter" = "latest"

# LSP / language tooling

"pipx:basedpyright" = "latest"
"npm:typescript-language-server" = "latest"
"npm:vscode-langservers-extracted" = "latest"
"npm:@vue/language-server" = "latest"
"npm:svelte-language-server" = {
    version = "latest",
    trust_policy_excludes = ["svelte@4.2.20"]
}
"npm:yaml-language-server" = "latest"
"npm:bash-language-server" = "latest"
"npm:intelephense" = "latest"
"npm:fish-lsp" = "latest"
"lua-language-server" = "latest"
"taplo" = "latest"
"go:golang.org/x/tools/gopls" = "latest"
"marksman" = "latest"
