#!/bin/sh
set -eu

{{ includeTemplate "lib/xdg-env.sh.tmpl" . }}
{{ includeTemplate "lib/msys2-env.sh.tmpl" . }}
{{ includeTemplate "lib/console.sh.tmpl" . }}

component="fish-init"
cache_dir="$XDG_CACHE_HOME/fish/init"

export PATH="$HOME/.local/bin:$XDG_DATA_HOME/mise/shims:$PATH"

# @param $1 Output file.
# @param $2 Environment mode: msys or native.
# @param $3... Generator command and arguments.
generate_init() (
    output_file="$1"
    environment_mode="$2"
    shift 2

    temp_file=$(mktemp "$cache_dir/.init.XXXXXX")
    trap 'rm -f "$temp_file"' EXIT INT TERM

    if ! (
{{ if eq .chezmoi.os "windows" -}}
        if [ "$environment_mode" = "native" ]; then
            msys2_export_native_environment
        fi
{{ end -}}
        "$@"
    ) >"$temp_file"; then
        console_status "ERROR" "$(basename "$output_file")" "init" "generation failed"
        console_failed "$component"
        exit 1
    fi

    mv "$temp_file" "$output_file"
    console_status "OK" "$(basename "$output_file")" "init" "generated"
)

console_header "$component" "Generate Fish integrations"
console_context "$cache_dir"

mkdir -p "$cache_dir"

generate_init "$cache_dir/atuin.fish" msys \
    atuin init fish --disable-up-arrow --disable-ai
generate_init "$cache_dir/carapace.fish" native \
    carapace _carapace fish
generate_init "$cache_dir/fzf.fish" native \
    fzf --fish
generate_init "$cache_dir/starship.fish" native \
    starship init fish --print-full-init
generate_init "$cache_dir/zoxide.fish" native \
    zoxide init fish

console_complete "$component" "Fish integrations generated"
