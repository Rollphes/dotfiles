#!/bin/sh
set -eu

{{ includeTemplate "lib/xdg-env.sh.tmpl" . }}
{{ includeTemplate "lib/console.sh.tmpl" . }}

component="procmon"

{{ if eq .chezmoi.os "windows" -}}
version="4.1"
archive_sha256="4ff309fe52c56599377896b7863cb77b6c601d9f2522e52da7a182eac593e8e1"
install_dir="$XDG_DATA_HOME/dotfiles-audit/procmon"
executable="$install_dir/Procmon64.exe"
version_file="$install_dir/version"

console_header "$component" "Install Process Monitor"
console_context "$executable"

if [ -f "$executable" ] \
    && [ -f "$version_file" ] \
    && [ "$(cat "$version_file")" = "$version" ]
then
    console_status "OK" "Process Monitor" "tool" "already installed"
    console_complete "$component" "Process Monitor available"
    exit 0
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
archive="$tmp_dir/ProcessMonitor.zip"
extract_dir="$tmp_dir/extract"

console_status "RUN" "Process Monitor" "tool" "installing"
if ! curl -fsSL \
    https://download.sysinternals.com/files/ProcessMonitor.zip \
    -o "$archive"
then
    console_status "ERROR" "Process Monitor" "download" "download failed"
    console_failed "$component"
    exit 1
fi

actual_sha256="$(sha256sum "$archive" | awk '{print $1}')"
if [ "$actual_sha256" != "$archive_sha256" ]; then
    console_status "ERROR" "Process Monitor" "checksum" "checksum mismatch"
    console_failed "$component"
    exit 1
fi

mkdir -p "$extract_dir"
if ! unzip -q -j "$archive" Procmon64.exe -d "$extract_dir"; then
    console_status "ERROR" "Process Monitor" "archive" "extraction failed"
    console_failed "$component"
    exit 1
fi

mkdir -p "$install_dir"
mv "$extract_dir/Procmon64.exe" "$executable"
printf '%s\n' "$version" > "$version_file"

console_status "OK" "Process Monitor" "tool" "installed"
console_complete "$component" "Process Monitor available"
{{ else -}}
exit 0
{{ end -}}
