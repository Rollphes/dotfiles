#!/bin/sh

set -eu

{{ includeTemplate "lib/xdg-env.sh.tmpl" . }}
{{ includeTemplate "lib/msys2-env.sh.tmpl" . }}
{{ includeTemplate "lib/console.sh.tmpl" . }}

{{- if eq .chezmoi.os "windows" }}

component="msys2"

console_header "$component" "Install required packages"
console_context "pacman"

packages="
fish
mingw-w64-ucrt-x86_64-curl
mingw-w64-ucrt-x86_64-git
mingw-w64-ucrt-x86_64-git-lfs
unzip
"

for package in $packages; do
    if pacman -Q "$package" >/dev/null 2>&1; then
        console_status "OK" "$package" "pkg" "already installed"
    else
        console_status "RUN" "$package" "pkg" "installing"

        if ! pacman -S --needed --noconfirm "$package"; then
            console_status "ERROR" "$package" "pkg" "installation failed"
            console_failed "$component"
            exit 1
        fi

        console_status "OK" "$package" "pkg" "installed"
    fi
done

console_complete "$component" "required packages installed"

{{- end }}
