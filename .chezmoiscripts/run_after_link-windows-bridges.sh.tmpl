#!/bin/sh
set -eu

{{ if eq .chezmoi.os "windows" -}}

{{ includeTemplate "lib/xdg-env.sh.tmpl" . }}
{{ includeTemplate "lib/msys2-env.sh.tmpl" . }}
{{ includeTemplate "lib/console.sh.tmpl" . }}
{{ includeTemplate "lib/windows-host-powershell.sh.tmpl" . }}

# Preserve mklink /D arguments across MSYS2 conversion.
export MSYS_NO_PATHCONV=1

component="windows-bridges"

ok_count=0
created_count=0
warn_count=0

fail() {
    console_status "ERROR" "-" "-" "$*" >&2
    console_failed "$component"
    exit 1
}

fail_topology_conflict() {
    name="$1"
    kind="$2"
    link="$3"
    target="$4"
    actual_type="$5"

    console_status \
        "ERROR" \
        "$name" \
        "$kind" \
        "topology conflict" >&2

    printf '\n' >&2
    console_detail "actual" "$actual_type: $link" >&2
    console_detail "expected" "symlink: $link" >&2
    console_detail "target" "$target" >&2

    console_failed "$component"
    exit 1
}

fail_wrong_target() {
    name="$1"
    kind="$2"
    link="$3"
    actual="$4"
    expected="$5"

    console_status \
        "ERROR" \
        "$name" \
        "$kind" \
        "wrong symlink target" >&2

    printf '\n' >&2
    console_detail "link" "$link" >&2
    console_detail "actual" "$actual" >&2
    console_detail "expected" "$expected" >&2

    console_failed "$component"
    exit 1
}

fail_unreadable_link() {
    name="$1"
    kind="$2"
    link="$3"
    target="$4"

    console_status \
        "ERROR" \
        "$name" \
        "$kind" \
        "unreadable symlink" >&2

    printf '\n' >&2
    console_detail "link" "$link" >&2
    console_detail "expected" "$target" >&2

    console_failed "$component"
    exit 1
}

fail_link_privilege() {
    name="$1"
    kind="$2"

    console_status \
        "ERROR" \
        "$name" \
        "$kind" \
        "cannot create symlink" >&2

    printf '\n' >&2
    console_detail \
        "reason" \
        "Windows Developer Mode or an existing symlink privilege is required" >&2

    console_failed "$component"
    exit 1
}

normalize_path() {
    realpath -m "$1" 2>/dev/null || return 1
}

resolve_link_target() (
    link="$1"
    target=$(readlink "$link") || return 1
    case "$target" in
        [A-Za-z]:[\\/]*) target=$(cygpath -u "$target") || return 1 ;;
        /*) ;;
        *) target="$(dirname "$link")/$target" ;;
    esac
    normalize_path "$target"
)

# Keep filesystem operations in the MSYS2 POSIX namespace.
msys2_user_profile=$(cygpath -u "{{ .chezmoi.destDir }}")

[ -x "$windows_powershell" ] || fail "Windows PowerShell not found: $windows_powershell"

host_profile_hint="${HOMEDRIVE:-}${HOMEPATH:-}"
[ -n "$host_profile_hint" ] || fail "HOMEDRIVE/HOMEPATH unavailable"
host_profile_hint=$(cygpath -w "$(cygpath -u "$host_profile_hint")")
host_profile_hint_posix=$(cygpath -u "$host_profile_hint")
[ "$host_profile_hint_posix" != "$msys2_user_profile" ] || fail "Host and development profiles must differ"
host_app_data_hint=$(cygpath -w "$host_profile_hint_posix/AppData/Roaming")
host_local_app_data_hint=$(cygpath -w "$host_profile_hint_posix/AppData/Local")

host_profile=$(windows_run_host_powershell \
    "$host_profile_hint" \
    "$host_app_data_hint" \
    "$host_local_app_data_hint" \
    -NoProfile -NonInteractive -Command '
{{ includeTemplate "lib/windows-host-profile.ps1.tmpl" . }}
') || fail "Cannot resolve the registered Windows host profile"
windows_user_profile=$(cygpath -u "$(printf '%s' "$host_profile" | tr -d '\r')")
[ "$windows_user_profile" != "$msys2_user_profile" ] || fail "Host and development profiles must differ"

reconcile_one() {
    kind="$1"
    name="$2"
    link="$3"
    target="$4"
    allow_missing_target="$5"

    case "$kind" in
        dir|file)
            ;;
        *)
            fail "unknown bridge kind '$kind' for '$name'"
            ;;
    esac

    if [ -L "$link" ]; then
        actual=$(resolve_link_target "$link") ||
            fail_unreadable_link "$name" "$kind" "$link" "$target"

        expected=$(normalize_path "$target") ||
            fail_unreadable_link "$name" "$kind" "$link" "$target"

        if [ "$actual" != "$expected" ]; then
            fail_wrong_target "$name" "$kind" "$link" "$actual" "$expected"
        fi

        console_status \
            "OK" \
            "$name" \
            "$kind" \
            "link: $link -> target: $target"

        ok_count=$((ok_count + 1))
        return 0
    fi

    # Never replace a real resource at a selected link endpoint.
    if [ -e "$link" ]; then
        if [ -d "$link" ]; then
            actual_type="real directory"
        elif [ -f "$link" ]; then
            actual_type="real file"
        else
            actual_type="real filesystem entry"
        fi

        fail_topology_conflict \
            "$name" \
            "$kind" \
            "$link" \
            "$target" \
            "$actual_type"
    fi

    if [ "$kind" = "dir" ] && [ ! -e "$target" ]; then
        mkdir -p "$target"
    fi

    if [ ! -e "$target" ] && [ "$allow_missing_target" != "true" ]; then
        console_status \
            "WARN" \
            "$name" \
            "$kind" \
            "target missing: $target" >&2

        warn_count=$((warn_count + 1))
        return 0
    fi

    mkdir -p "$(dirname "$link")"

    link_win=$(cygpath -w "$link")
    target_win=$(cygpath -w "$target")

    if [ "$kind" = "dir" ]; then
        cmd.exe /c mklink /D "$link_win" "$target_win" >/dev/null ||
            fail_link_privilege "$name" "$kind"
    else
        cmd.exe /c mklink "$link_win" "$target_win" >/dev/null ||
            fail_link_privilege "$name" "$kind"
    fi

    console_status \
        "CREATED" \
        "$name" \
        "$kind" \
        "link: $link -> target: $target"

    created_count=$((created_count + 1))
}

console_header "$component" "Reconciling cross-home bridges"
console_detail "topology" "msys2.bridgesTo.windows (MSYS2 target, Windows symlink)"
console_detail "topology" "windows.bridgesTo.msys2 (Windows target, MSYS2 symlink)"
printf '\n'

{{ range $location, $_ := .msys2.bridgesTo -}}
{{ if ne $location "windows" -}}
fail "unknown MSYS2 bridge location '{{ $location }}'"
{{ end -}}
{{ end -}}
{{ range $location, $_ := .windows.bridgesTo -}}
{{ if ne $location "msys2" -}}
fail "unknown Windows bridge location '{{ $location }}'"
{{ end -}}
{{ end -}}

{{ range .msys2.bridgesTo.windows -}}
reconcile_one \
    "{{ .kind }}" \
    "{{ .path }}" \
    "$windows_user_profile/{{ .path }}" \
    "$msys2_user_profile/{{ .path }}" \
    "{{ .allowMissingTarget }}"
{{ end -}}

{{ range .windows.bridgesTo.msys2 -}}
reconcile_one \
    "{{ .kind }}" \
    "{{ .path }}" \
    "$msys2_user_profile/{{ .path }}" \
    "$windows_user_profile/{{ .path }}" \
    "{{ .allowMissingTarget }}"
{{ end -}}

console_complete \
    "$component" \
    "$ok_count ok, $created_count created, $warn_count warning(s)"

{{ end -}}
