#!/bin/sh
# Hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}

set -eu

{{ includeTemplate "lib/msys2-env.sh.tmpl" . }}
{{ includeTemplate "lib/console.sh.tmpl" . }}

component="fisher"

console_header "$component" "Sync fish plugins"
console_context "$HOME/.config/fish/fish_plugins"

if ! command -v fish >/dev/null 2>&1; then
    console_status "ERROR" "fish" "tool" "not found"
    console_failed "$component"
    exit 1
fi

console_status "OK" "fish" "tool" "available"

if ! command -v curl >/dev/null 2>&1; then
    console_status "ERROR" "curl" "tool" "not found"
    console_failed "$component"
    exit 1
fi

console_status "OK" "curl" "tool" "available"

if ! fish -c '
    if not functions -q fisher
        curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    end

    fisher update
'; then
    console_status "ERROR" "fish_plugins" "sync" "fisher update failed"
    console_failed "$component"
    exit 1
fi

console_status "OK" "fish_plugins" "sync" "plugins synchronized"
console_complete "$component" "fish plugins synchronized"
