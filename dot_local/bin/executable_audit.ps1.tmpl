<#
.SYNOPSIS
Compares Windows runtime state before and after an interactive or apply session.

.DESCRIPTION
Start records filesystem snapshots, stop records and compares the final state,
and report regenerates the human-readable report from the stored diff. No
background process remains active between start and stop.
#>
[CmdletBinding()]
param(
    [Parameter(Mandatory, Position = 0)]
    [ValidateSet('start', 'stop', 'report')]
    [string] $Command,
    [string] $Session,
    [string] $CanonicalHome,
    [string] $HostProfile,
    [string] $HostTemp,
    [string] $HostLocalAppData,
    [string] $HostRoamingAppData,
    [string[]] $WorkspaceRoots = @(),
    [string] $StateRoot,
    [switch] $HashFiles
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$MonitoredRootIds = @('hostProfile', 'local', 'roaming', 'temp', 'canonicalAppData')
$DefaultMsys2BridgesToWindowsPaths = @(
{{ range .msys2.bridgesTo.windows -}}
    '{{ .path }}'
{{ end -}}
)
$DefaultWindowsBridgesToMsys2Paths = @(
{{ range .windows.bridgesTo.msys2 -}}
    '{{ .path }}'
{{ end -}}
)
$ManagedFontPatterns = @(
{{ range .fonts -}}
    '{{ .filePattern }}'
{{ end -}}
)

function Resolve-FullPath {
    param([Parameter(Mandatory)][string] $Path)
    if (($Path -replace '\\', '/') -match '(^|/)\.ssh(/|$)') { throw 'SSH paths are excluded without filesystem access.' }
    $fullPath = [IO.Path]::GetFullPath($Path)
    $root = [IO.Path]::GetPathRoot($fullPath)
    if ($fullPath.Equals($root, [StringComparison]::OrdinalIgnoreCase)) { return $root }
    return $fullPath.TrimEnd([IO.Path]::DirectorySeparatorChar, [IO.Path]::AltDirectorySeparatorChar)
}

function Test-WindowsAbsolutePath {
    param([string] $Path)
    return $Path -match '^(?:[A-Za-z]:[\\/]|\\\\)'
}

function Test-PathWithin {
    param([Parameter(Mandatory)][string] $Path, [Parameter(Mandatory)][string] $Root)
    $candidate = Resolve-FullPath $Path
    $rootPath = Resolve-FullPath $Root
    return $candidate.Equals($rootPath, [StringComparison]::OrdinalIgnoreCase) -or
        $candidate.StartsWith("$rootPath\", [StringComparison]::OrdinalIgnoreCase)
}

function Resolve-CanonicalHome {
    if ($CanonicalHome) { return Resolve-FullPath $CanonicalHome }
    if ($env:HOME -and (Test-WindowsAbsolutePath $env:HOME)) { return Resolve-FullPath $env:HOME }
    if (-not $env:USERNAME) { throw 'Cannot derive the MSYS2 canonical home: USERNAME is unset.' }
    return Resolve-FullPath (Join-Path 'C:\msys64\home' $env:USERNAME)
}

function Resolve-HostProfile {
    if ($HostProfile) { return Resolve-FullPath $HostProfile }
    $profile = & {
{{ includeTemplate "lib/windows-host-profile.ps1.tmpl" . }}
    }
    if (-not $profile) { throw 'Cannot derive the Windows host profile.' }
    return Resolve-FullPath $profile
}

function Resolve-StateRoot {
    param([Parameter(Mandatory)][string] $HomePath)
    if ($StateRoot) { return Resolve-FullPath $StateRoot }
    if ($env:XDG_STATE_HOME -and (Test-WindowsAbsolutePath $env:XDG_STATE_HOME)) {
        return Resolve-FullPath (Join-Path $env:XDG_STATE_HOME 'dotfiles-leakage-audit')
    }
    return Resolve-FullPath (Join-Path $HomePath '.local\state\dotfiles-leakage-audit')
}

function Get-OSStateExclusions([string] $ProfilePath) {
    # Observed locked NTUSER hive, journal and transaction files. Enumerate only
    # this filename family; never enumerate any SSH directory or inspect its metadata.
    if (-not [IO.Directory]::Exists($ProfilePath)) { return @() }
    @([IO.Directory]::EnumerateFiles($ProfilePath, 'NTUSER.DAT*', [IO.SearchOption]::TopDirectoryOnly) |
        Where-Object { [IO.Path]::GetFileName($_) -match '^ntuser\.dat(?:\.LOG[12]|\{[0-9a-f-]{36}\}\.TM(?:\.blf|Container[0-9]+\.regtrans-ms))?$' })
}

function Get-RunnerStateExclusions(
    [string] $ProfilePath,
    [string] $LocalPath,
    [string] $CanonicalAppDataPath
) {
    if ($env:GITHUB_ACTIONS -ne 'true' -or $env:RUNNER_ENVIRONMENT -ne 'github-hosted') {
        return @()
    }
    # Observed in GitHub-hosted runs 34536176054 and 34671495614. These are
    # browser and Windows caches maintained by the runner image, scoped to
    # their exact roots.
    return @(
        (Join-Path $LocalPath 'Microsoft\Windows\WebCache'),
        (Join-Path $LocalPath 'Microsoft\Windows\INetCache\IE'),
        (Join-Path $LocalPath 'Microsoft\TokenBroker\Cache'),
        (Join-Path $LocalPath 'Mozilla\Firefox'),
        (Join-Path $ProfilePath 'AppData\LocalLow\Microsoft\CryptnetUrlCache'),
        (Join-Path $ProfilePath 'AppData\Roaming\Mozilla\Firefox'),
        (Join-Path $CanonicalAppDataPath 'Local\Microsoft\Feeds Cache'),
        (Join-Path $CanonicalAppDataPath 'Local\Microsoft\Windows\History'),
        (Join-Path $CanonicalAppDataPath 'Local\Microsoft\Windows\INetCache'),
        (Join-Path $CanonicalAppDataPath 'Local\Microsoft\Windows\INetCookies')
    )
}

function Get-RunnerStateEntries([string] $CanonicalAppDataPath) {
    if ($env:GITHUB_ACTIONS -ne 'true' -or $env:RUNNER_ENVIRONMENT -ne 'github-hosted') {
        return @()
    }
    # This observed empty directory is classified entry-by-entry so an
    # unexpected descendant remains visible to the audit.
    return @((Join-Path $CanonicalAppDataPath 'Roaming'))
}

function Get-RunnerStateRules {
    if ($env:GITHUB_ACTIONS -ne 'true' -or $env:RUNNER_ENVIRONMENT -ne 'github-hosted') {
        return @()
    }
    # Windows-hosted run 34870817977 created or updated these OS/app-owned
    # package-family and shell state paths while the first-apply audit ran.
    # Keep each rule anchored to the local root and the exact Windows identity.
    return @(
        [ordered]@{
            root = 'local'
            statuses = @('new', 'modified', 'metadataOnly')
            pathPattern = '^Packages/Microsoft\.SecHealthUI_8wekyb3d8bbwe(?:/(?:AC(?:/(?:INetCache|INetCookies|INetHistory|Temp))?|AppData|LocalCache|LocalState|RoamingState|Settings(?:/(?:roaming\.lock|settings\.dat))?|SystemAppData|TempState))?$'
            description = 'Windows Security package-family state'
        },
        [ordered]@{
            root = 'local'
            statuses = @('new', 'modified', 'metadataOnly')
            pathPattern = '^Packages/Microsoft\.VCLibs\.140\.00_8wekyb3d8bbwe(?:/AC(?:/(?:INetCache|INetCookies|INetHistory|Temp))?)?$'
            description = 'Microsoft VCLibs package-family app-container state'
        },
        [ordered]@{
            root = 'local'
            statuses = @('new', 'modified', 'metadataOnly')
            pathPattern = '^Microsoft/Windows/Notifications/wpndatabase\.db-wal$'
            description = 'Windows notification database journal'
        },
        [ordered]@{
            root = 'local'
            statuses = @('new', 'modified', 'metadataOnly')
            pathPattern = '^Packages/Microsoft\.Windows\.StartMenuExperienceHost_cw5n1h2txyewy/TempState(?:/StartUnifiedTileModelCache\.dat)?$'
            description = 'Windows Start menu transient tile cache'
        },
        [ordered]@{
            root = 'local'
            statuses = @('new', 'modified', 'metadataOnly')
            pathPattern = '^Packages/MicrosoftWindows\.Client\.CBS_cw5n1h2txyewy/TempState(?:/SearchUnifiedTileModelCache\.dat)?$'
            description = 'Windows Search transient tile cache'
        },
        [ordered]@{
            root = 'local'
            statuses = @('metadataOnly')
            pathPattern = '^Packages$'
            description = 'Package-state container metadata'
        }
    )
}

function Write-JsonFile {
    param([Parameter(Mandatory)] $Value, [Parameter(Mandatory)][string] $Path)
    $Value | ConvertTo-Json -Depth 12 | Set-Content -LiteralPath $Path -Encoding utf8
}

function Read-JsonFile {
    param([Parameter(Mandatory)][string] $Path)
    return Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json
}

function Resolve-SessionDirectory {
    param([Parameter(Mandatory)][string] $AuditStateRoot, [switch] $RequireActive)
    $sessionDirectory = if ($Session) {
        $candidate = if (Test-WindowsAbsolutePath $Session) { $Session } else { Join-Path $AuditStateRoot $Session }
        Resolve-FullPath $candidate
    } else {
        $activePath = Join-Path $AuditStateRoot 'active.json'
        if (Test-Path -LiteralPath $activePath) {
            (Read-JsonFile $activePath).sessionDirectory
        } else {
            if ($RequireActive) { throw 'No active audit session was found.' }
            $latest = Get-ChildItem -LiteralPath $AuditStateRoot -Directory -ErrorAction SilentlyContinue |
                Sort-Object Name -Descending | Select-Object -First 1
            if (-not $latest) { throw 'No audit session was found.' }
            $latest.FullName
        }
    }
    $resolved = Resolve-FullPath $sessionDirectory
    $stateRootPath = Resolve-FullPath $AuditStateRoot
    if ($resolved.Equals($stateRootPath, [StringComparison]::OrdinalIgnoreCase) -or
        -not (Test-PathWithin $resolved $stateRootPath)) {
        throw "Audit session must remain below the audit state root: $resolved"
    }
    return $resolved
}

if (-not ('AuditSnapshotWriter' -as [type])) {
    Add-Type -TypeDefinition @'
using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Security.Cryptography;
using System.Text;

public static class AuditSnapshotWriter
{
    private const string Header = "\"path\",\"type\",\"size\",\"lastWriteTimeUtc\",\"sha256\",\"linkTarget\"";

    public static void WriteRecursive(string root, string output, bool hashFiles, string[] excludedRoots)
    {
        WriteRecursive(root, output, hashFiles, excludedRoots, false);
    }

    public static void WriteRecursive(string root, string output, bool hashFiles, string[] excludedRoots, bool includeRoot)
    {
        using (var writer = NewWriter(output))
        {
            if (IsExcluded(root, excludedRoots ?? Array.Empty<string>()))
                throw new InvalidOperationException("Snapshot root is excluded");
            if (Directory.Exists(root))
            {
                if (includeRoot && !IsExclusionContainer(root, excludedRoots))
                    WriteEntry(writer, root, ".", hashFiles);
                WriteTree(writer, root, root, "", hashFiles, excludedRoots ?? Array.Empty<string>());
            }
        }
    }

    private static StreamWriter NewWriter(string output)
    {
        var writer = new StreamWriter(output, false, new UTF8Encoding(false));
        writer.WriteLine(Header);
        return writer;
    }

    private static void WriteTree(StreamWriter writer, string root, string start, string relativeBase, bool hashFiles, string[] exclusions)
    {
        var pending = new Stack<string>();
        pending.Push(start);
        while (pending.Count > 0)
        {
            var directory = pending.Pop();
            foreach (var path in Directory.EnumerateFileSystemEntries(directory))
            {
                if (IsExcluded(path, exclusions)) continue;
                var attributes = File.GetAttributes(path);
                var relative = Path.GetRelativePath(root, path);
                if (!String.IsNullOrEmpty(relativeBase)) relative = Path.Combine(relativeBase, relative);
                // Ancestors of excluded bridges are containers, not audited state.
                // Still descend to detect writes to every non-excluded sibling.
                if (!IsExclusionContainer(path, exclusions))
                    WriteEntry(writer, path, relative, hashFiles);
                if ((attributes & FileAttributes.Directory) != 0 &&
                    (attributes & FileAttributes.ReparsePoint) == 0)
                    pending.Push(path);
            }
        }
    }

    private static void WriteEntry(StreamWriter writer, string path, string relative, bool hashFiles)
    {
        var info = (File.GetAttributes(path) & FileAttributes.Directory) != 0
            ? (FileSystemInfo)new DirectoryInfo(path)
            : new FileInfo(path);
        var reparse = (info.Attributes & FileAttributes.ReparsePoint) != 0;
        var type = reparse ? "reparsePoint" : info is DirectoryInfo ? "directory" : "file";
        var size = !reparse && info is FileInfo file ? file.Length.ToString(CultureInfo.InvariantCulture) : "";
        var hash = hashFiles && !reparse && info is FileInfo ? Hash(path) : "";
        var target = reparse ? info.LinkTarget ?? "" : "";
        writer.WriteLine(String.Join(",", new[] {
            Csv(relative.Replace('\\', '/').TrimStart('/')),
            Csv(type),
            Csv(size),
            Csv(info.LastWriteTimeUtc.ToString("o", CultureInfo.InvariantCulture)),
            Csv(hash),
            Csv(target.Replace('\\', '/'))
        }));
    }

    private static string Hash(string path)
    {
        using (var stream = File.OpenRead(path))
        using (var sha = SHA256.Create())
            return BitConverter.ToString(sha.ComputeHash(stream)).Replace("-", "").ToLowerInvariant();
    }

    private static bool IsExcluded(string path, string[] roots)
    {
        // Check names before any Exists, attributes, metadata, or file access.
        foreach (var part in path.Replace('\\', '/').Split('/'))
            if (part.Equals(".ssh", StringComparison.OrdinalIgnoreCase)) return true;
        var candidate = Path.GetFullPath(path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        foreach (var root in roots)
        {
            var expected = Path.GetFullPath(root).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            if (candidate.Equals(expected, StringComparison.OrdinalIgnoreCase) ||
                candidate.StartsWith(expected + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
                return true;
        }
        return false;
    }

    private static bool IsExclusionContainer(string path, string[] roots)
    {
        var container = Path.GetFullPath(path).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar)
            + Path.DirectorySeparatorChar;
        return Array.Exists(roots, root => Path.GetFullPath(root).StartsWith(container, StringComparison.OrdinalIgnoreCase));
    }

    private static string Csv(string value)
    {
        return "\"" + (value ?? "").Replace("\"", "\"\"") + "\"";
    }
}
'@
}

function New-SnapshotSet {
    param([Parameter(Mandatory)] $Metadata, [Parameter(Mandatory)][string] $Directory)
    New-Item -ItemType Directory -Path $Directory -Force | Out-Null
    foreach ($id in $MonitoredRootIds) {
        $exclusions = @($Metadata.managedBridgeRoots) + @($Metadata.osStateExclusions) +
            @($Metadata.runnerStateExclusions) + @($Metadata.workspaceRoots) +
            @($Metadata.auditStateRoot)
        if ($id -ne 'canonicalAppData') { $exclusions += $Metadata.roots.canonicalHome }
        if ($id -eq 'hostProfile') { $exclusions += @($Metadata.roots.local, $Metadata.roots.roaming, $Metadata.roots.temp) }
        if ($id -eq 'local') { $exclusions += $Metadata.roots.temp }
        [AuditSnapshotWriter]::WriteRecursive(
            $Metadata.roots.$id, (Join-Path $Directory "$id.csv"), $Metadata.hashFiles, [string[]]$exclusions,
            ($id -eq 'canonicalAppData')
        )
    }
}

function Compare-Snapshot {
    param([Parameter(Mandatory)] $Before, [Parameter(Mandatory)] $After)
    $beforeByPath = @{}
    foreach ($entry in @($Before.entries)) { $beforeByPath[$entry.path.ToLowerInvariant()] = $entry }
    $afterByPath = @{}
    foreach ($entry in @($After.entries)) { $afterByPath[$entry.path.ToLowerInvariant()] = $entry }
    $new = [Collections.Generic.List[object]]::new()
    $modified = [Collections.Generic.List[object]]::new()
    $deleted = [Collections.Generic.List[object]]::new()
    $metadataOnly = [Collections.Generic.List[object]]::new()
    foreach ($key in @($afterByPath.Keys)) {
        $current = $afterByPath[$key]
        if (-not $beforeByPath.ContainsKey($key)) { $new.Add($current); continue }
        $previous = $beforeByPath[$key]
        $contentChanged = $previous.type -cne $current.type -or
            $previous.size -ne $current.size -or
            $previous.linkTarget -cne $current.linkTarget -or
            ($previous.sha256 -and $current.sha256 -and $previous.sha256 -cne $current.sha256)
        if ($contentChanged) {
            $modified.Add([pscustomobject]@{ path = $current.path; before = $previous; after = $current })
        } elseif ($previous.lastWriteTimeUtc -cne $current.lastWriteTimeUtc) {
            $metadataOnly.Add([pscustomobject]@{ path = $current.path; before = $previous; after = $current })
        }
    }
    foreach ($key in @($beforeByPath.Keys)) {
        if (-not $afterByPath.ContainsKey($key)) { $deleted.Add($beforeByPath[$key]) }
    }
    return [ordered]@{
        new = @($new | Sort-Object path)
        modified = @($modified | Sort-Object path)
        deleted = @($deleted | Sort-Object path)
        metadataOnly = @($metadataOnly | Sort-Object path)
    }
}

function New-DiffSet {
    param([Parameter(Mandatory)][string] $SessionDirectory)
    $diffDirectory = Join-Path $SessionDirectory 'diff'
    New-Item -ItemType Directory -Path $diffDirectory -Force | Out-Null
    $diffs = [ordered]@{}
    foreach ($id in $MonitoredRootIds) {
        $before = [pscustomobject]@{
            entries = @(Import-Csv -LiteralPath (Join-Path $SessionDirectory "before\$id.csv"))
        }
        $after = [pscustomobject]@{
            entries = @(Import-Csv -LiteralPath (Join-Path $SessionDirectory "after\$id.csv"))
        }
        $diff = Compare-Snapshot $before $after
        Write-JsonFile $diff (Join-Path $diffDirectory "$id.json")
        $diffs[$id] = $diff
    }
    return $diffs
}

function Add-DiffSection {
    param([Parameter(Mandatory)] $Lines, [Parameter(Mandatory)][string] $Title, [Parameter(Mandatory)] $Diff)
    $Lines.Add($Title)
    foreach ($status in 'new', 'modified', 'deleted', 'metadataOnly') {
        $values = @($Diff.$status)
        $label = if ($status -eq 'metadataOnly') { 'METADATA ONLY' } else { $status.ToUpperInvariant() }
        $Lines.Add("  ${label}: $($values.Count)")
        foreach ($value in ($values | Select-Object -First 50)) { $Lines.Add("    $($value.path)") }
        if ($values.Count -gt 50) { $Lines.Add('    ... first 50 shown; complete entries are retained in diff/*.json') }
    }
    $Lines.Add('')
}

function New-Report {
    param([Parameter(Mandatory)] $Metadata, [Parameter(Mandatory)] $Diffs)
    $lines = [Collections.Generic.List[string]]::new()
    $lines.Add("Windows runtime leakage audit: $($Metadata.sessionId)")
    $lines.Add("Started: $($Metadata.startedAtUtc)")
    $lines.Add("Stopped: $($Metadata.stoppedAtUtc)")
    $lines.Add('')
    Add-DiffSection $lines 'HOST LOCAL LEAKAGE CANDIDATE' $Diffs.local
    Add-DiffSection $lines 'HOST ROAMING LEAKAGE CANDIDATE' $Diffs.roaming
    Add-DiffSection $lines 'HOST TEMP USAGE' $Diffs.temp
    Add-DiffSection $lines 'HOST PROFILE WRITES' $Diffs.hostProfile
    Add-DiffSection $lines 'RETIRED CANONICAL APPDATA WRITES' $Diffs.canonicalAppData
    $lines.Add('MANAGED BRIDGE')
    $lines.Add('  Excluded bridge endpoints:')
    foreach ($path in @($Metadata.managedBridgeRoots)) { $lines.Add("    $path") }
    $lines.Add('OS STATE EXCLUSIONS (observed locked/inaccessible paths)')
    foreach ($path in @($Metadata.osStateExclusions)) { $lines.Add("    $path") }
    $lines.Add('GITHUB-HOSTED RUNNER OS EXCLUSIONS (observed paths)')
    foreach ($path in @($Metadata.runnerStateExclusions)) { $lines.Add("    $path") }
    $lines.Add('GITHUB-HOSTED RUNNER OS EXACT ENTRIES (classified after detection)')
    foreach ($path in @($Metadata.runnerStateEntries)) { $lines.Add("    $path") }
    $lines.Add('GITHUB-HOSTED RUNNER OS STATE RULES (classified after detection)')
    foreach ($rule in @($Metadata.runnerStateRules)) {
        $lines.Add("    [$($rule.root)] $($rule.description): $($rule.pathPattern)")
    }
    $lines.Add('EXPLICIT WORKSPACE EXCLUSIONS')
    $workspaceProperty = $Metadata.PSObject.Properties['workspaceRoots']
    if ($null -ne $workspaceProperty) {
        foreach ($path in @($workspaceProperty.Value)) { $lines.Add("    $path") }
    }
    $lines.Add("CONTENT HASHING: $($Metadata.hashFiles)")
    $policy = Write-PolicyResult $Metadata $Diffs
    $lines.Add("MANAGED HOST ASSET CHANGES: $(@($policy.managedHostAssets).Count)")
    $lines.Add("RUNNER OS STATE CHANGES: $(@($policy.runnerOsStateChanges).Count)")
    $lines.Add('POLICY VIOLATIONS:')
    if (@($policy.violations).Count) {
        foreach ($violation in @($policy.violations)) {
            $lines.Add("  $($violation.status.ToUpperInvariant()) [$($violation.root)]: $($violation.path)")
        }
    } else {
        $lines.Add('  None')
    }
    $lines.Add("POLICY: $($policy.decision) ($(@($policy.violations).Count) forbidden writes)")
    $reportPath = Join-Path $Metadata.sessionDirectory 'report.txt'
    $lines | Set-Content -LiteralPath $reportPath -Encoding utf8
    return $reportPath
}

function Write-PolicyResult {
    param($Metadata, $Diffs)
    $allowed = [Collections.Generic.List[object]]::new()
    $runnerOsState = [Collections.Generic.List[object]]::new()
    $violations = @(foreach ($id in $MonitoredRootIds) {
        foreach ($status in 'new', 'modified', 'metadataOnly') {
            foreach ($entry in @($Diffs[$id].$status)) {
                $record = [pscustomobject]@{ root = $id; status = $status; path = $entry.path }
                # Existing managed host assets, restricted to manifest font names.
                # Font verification separately checks registration, family and file set.
                $fontName = $entry.path -replace '^Microsoft/Windows/Fonts/', ''
                $managedFont = $id -eq 'local' -and $entry.path.StartsWith('Microsoft/Windows/Fonts/', [StringComparison]::OrdinalIgnoreCase) -and
                    @($Metadata.managedFontPatterns | Where-Object { $fontName -match $_ }).Count -gt 0
                $current = if ($status -eq 'new') { $entry } else { $entry.after }
                $fontContainer = $id -eq 'local' -and $current.type -eq 'directory' -and
                    $entry.path -in @('Microsoft', 'Microsoft/Windows', 'Microsoft/Windows/Fonts')
                $absolutePath = Resolve-FullPath (Join-Path $Metadata.roots.$id ($entry.path -replace '/', '\'))
                $runnerEntry = @($Metadata.runnerStateEntries | Where-Object {
                    $absolutePath.Equals($_, [StringComparison]::OrdinalIgnoreCase)
                }).Count -gt 0
                $runnerRule = @($Metadata.runnerStateRules | Where-Object {
                    $_.root -eq $id -and
                    @($_.statuses) -contains $status -and
                    $entry.path -match $_.pathPattern
                }).Count -gt 0
                if ($managedFont -or $fontContainer) {
                    $allowed.Add($record)
                } elseif ($runnerEntry -or $runnerRule) {
                    $runnerOsState.Add($record)
                } else {
                    $record
                }
            }
        }
    })
    $result = [ordered]@{
        schemaVersion = 1
        decision = if ($violations.Count) { 'fail' } else { 'pass' }
        violations = $violations
        managedHostAssets = @($allowed)
        runnerOsStateChanges = @($runnerOsState)
        deletedPolicy = 'informational: removal alone is not a state write'
    }
    Write-JsonFile $result (Join-Path $Metadata.sessionDirectory 'policy.json')
    return $result
}

function Read-DiffSet {
    param([Parameter(Mandatory)][string] $SessionDirectory)
    $diffs = [ordered]@{}
    foreach ($id in $MonitoredRootIds) {
        $diffs[$id] = Read-JsonFile (Join-Path $SessionDirectory "diff\$id.json")
    }
    return $diffs
}

$canonicalHomePath = Resolve-CanonicalHome
$canonicalAppDataPath = Resolve-FullPath (Join-Path $canonicalHomePath 'AppData')
$auditStateRoot = Resolve-StateRoot $canonicalHomePath
if ($Command -eq 'start') {
    $hostProfilePath = Resolve-HostProfile
    if (-not [IO.Directory]::Exists($hostProfilePath)) { throw "Host profile directory is unavailable: $hostProfilePath" }
    # Explicit synthetic/alternate profiles default to their own AppData tree.
    # Ordinary interactive audits use the registered host folders, not env vars.
    if (-not $HostProfile) {
        $shellFolders = 'Registry::HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders'
        if (-not $HostLocalAppData) { $HostLocalAppData = Get-ItemPropertyValue -LiteralPath $shellFolders -Name 'Local AppData' }
        if (-not $HostRoamingAppData) { $HostRoamingAppData = Get-ItemPropertyValue -LiteralPath $shellFolders -Name 'AppData' }
    }
    $hostLocalPath = Resolve-FullPath $(if ($HostLocalAppData) { $HostLocalAppData } else { Join-Path $hostProfilePath 'AppData\Local' })
    $hostRoamingPath = Resolve-FullPath $(if ($HostRoamingAppData) { $HostRoamingAppData } else { Join-Path $hostProfilePath 'AppData\Roaming' })
} else {
    $savedSession = Resolve-SessionDirectory $auditStateRoot -RequireActive
    $savedMetadata = Read-JsonFile (Join-Path $savedSession 'metadata.json')
    if ($savedMetadata.schemaVersion -ne 6) { throw 'Obsolete audit schema; start a new audit session with the current script.' }
    $hostProfilePath = Resolve-FullPath $savedMetadata.roots.hostProfile
    $HostTemp = $savedMetadata.roots.temp
    $hostLocalPath = $savedMetadata.roots.local
    $hostRoamingPath = $savedMetadata.roots.roaming
}
if (-not (Test-PathWithin $auditStateRoot $canonicalHomePath) -or
    (Test-PathWithin $auditStateRoot $hostProfilePath)) {
    throw "Audit state must remain in the separate canonical development home: $auditStateRoot"
}
$hostTempPath = if ($HostTemp) { Resolve-FullPath $HostTemp } else {
    Join-Path $hostLocalPath 'Temp'
}
foreach ($root in $hostTempPath, $hostLocalPath, $hostRoamingPath) {
    if (Test-PathWithin $root $canonicalHomePath) {
        throw 'Host roots must identify original host folders, not development environment paths.'
    }
}
$workspacePaths = @($WorkspaceRoots | ForEach-Object { Resolve-FullPath $_ })
foreach ($workspacePath in $workspacePaths) {
    foreach ($monitoredRoot in $hostProfilePath, $hostLocalPath, $hostRoamingPath, $hostTempPath, $canonicalAppDataPath) {
        if (Test-PathWithin $monitoredRoot $workspacePath) {
            throw "A workspace must not hide an entire monitored root: $workspacePath"
        }
    }
}

switch ($Command) {
    'start' {
        New-Item -ItemType Directory -Path $auditStateRoot -Force | Out-Null
        $activePath = Join-Path $auditStateRoot 'active.json'
        if (Test-Path -LiteralPath $activePath) {
            $active = Read-JsonFile $activePath
            if ($active.status -eq 'running') { throw "Audit session is already running: $($active.sessionDirectory)" }
        }
        $sessionId = [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssfffZ')
        $sessionDirectory = Join-Path $auditStateRoot $sessionId
        New-Item -ItemType Directory -Path $sessionDirectory | Out-Null
        $metadata = [ordered]@{}
        try {
            $metadata = [ordered]@{
                schemaVersion = 6
                sessionId = $sessionId
                status = 'starting'
                startedAtUtc = [DateTime]::UtcNow.ToString('o')
                stoppedAtUtc = $null
                sessionDirectory = $sessionDirectory
                roots = [ordered]@{
                    canonicalHome = $canonicalHomePath
                    canonicalAppData = $canonicalAppDataPath
                    hostProfile = $hostProfilePath
                    local = $hostLocalPath
                    roaming = $hostRoamingPath
                    temp = $hostTempPath
                }
                auditStateRoot = $auditStateRoot
                monitoredRootIds = $MonitoredRootIds
                workspaceRoots = $workspacePaths
                hashFiles = [bool]$HashFiles
                managedFontPatterns = $ManagedFontPatterns
                # Observed locked on Windows: OS registry storage, not a tool state file.
                osStateExclusions = @(Get-OSStateExclusions $hostProfilePath) + @(
                    # Observed inaccessible Windows performance assessment state.
                    (Join-Path $hostTempPath 'WinSAT'),
                    # Observed host registry log and Windows PowerShell startup cache.
                    (Join-Path $hostLocalPath 'Microsoft\Windows\UsrClass.dat.LOG1'),
                    (Join-Path $hostLocalPath 'Microsoft\Windows\UsrClass.dat.LOG2'),
                    (Join-Path $hostLocalPath 'Microsoft\Windows\PowerShell\StartupProfileData-NonInteractive')
                )
                runnerStateExclusions = @(Get-RunnerStateExclusions $hostProfilePath $hostLocalPath $canonicalAppDataPath)
                runnerStateEntries = @(Get-RunnerStateEntries $canonicalAppDataPath)
                runnerStateRules = @(Get-RunnerStateRules)
                policy = 'After exact bridge and OS exclusions, new, modified, metadataOnly host or canonical AppData entries fail except manifest-managed fonts and observed GitHub-hosted runner state; deleted entries are informational.'
                exclusions = @('Any .ssh path component before filesystem access', 'Managed bridges and their container metadata', 'Canonical home except its forbidden AppData root', 'Audit state', 'Explicit command workspaces', 'Observed GitHub-hosted runner OS paths and exact entries')
                environment = [ordered]@{
                    HOME = $env:HOME; USERPROFILE = $env:USERPROFILE; APPDATA = $env:APPDATA
                    LOCALAPPDATA = $env:LOCALAPPDATA; TEMP = $env:TEMP; TMP = $env:TMP
                    XDG_CONFIG_HOME = $env:XDG_CONFIG_HOME; XDG_DATA_HOME = $env:XDG_DATA_HOME
                    XDG_STATE_HOME = $env:XDG_STATE_HOME; XDG_CACHE_HOME = $env:XDG_CACHE_HOME
                }
                managedBridgeRoots = @(
                    @($DefaultMsys2BridgesToWindowsPaths | ForEach-Object {
                        $relativePath = $_ -replace '/', '\'
                        Resolve-FullPath (Join-Path $hostProfilePath $relativePath)
                        Resolve-FullPath (Join-Path $canonicalHomePath $relativePath)
                    })
                    @($DefaultWindowsBridgesToMsys2Paths | ForEach-Object {
                        $relativePath = $_ -replace '/', '\'
                        Resolve-FullPath (Join-Path $canonicalHomePath $relativePath)
                        Resolve-FullPath (Join-Path $hostProfilePath $relativePath)
                    })
                )
            }
            Write-JsonFile $metadata (Join-Path $sessionDirectory 'metadata.json')
            New-SnapshotSet $metadata (Join-Path $sessionDirectory 'before')
            $metadata.status = 'running'
            Write-JsonFile $metadata (Join-Path $sessionDirectory 'metadata.json')
            Write-JsonFile @{ status = 'running'; sessionDirectory = $sessionDirectory } $activePath
        } catch {
            $metadata.status = 'start-failed'
            $metadata.failure = $_.Exception.Message
            Write-JsonFile $metadata (Join-Path $sessionDirectory 'metadata.json')
            Write-JsonFile @{ status = 'start-failed'; sessionDirectory = $sessionDirectory } $activePath
            throw
        }
        Write-Output "Audit started: $sessionDirectory"
    }
    'stop' {
        $sessionDirectory = Resolve-SessionDirectory $auditStateRoot -RequireActive
        $metadataPath = Join-Path $sessionDirectory 'metadata.json'
        $metadata = Read-JsonFile $metadataPath
        if ($metadata.status -ne 'running') { throw "Audit session is not running: $sessionDirectory" }
        New-SnapshotSet $metadata (Join-Path $sessionDirectory 'after')
        $diffs = New-DiffSet $sessionDirectory
        $metadata.status = 'stopped'
        $metadata.stoppedAtUtc = [DateTime]::UtcNow.ToString('o')
        Write-JsonFile $metadata $metadataPath
        Write-JsonFile @{ status = 'stopped'; sessionDirectory = $sessionDirectory } (Join-Path $auditStateRoot 'active.json')
        $reportPath = New-Report $metadata $diffs
        Write-Output "Audit stopped: $sessionDirectory"
        Write-Output "Report: $reportPath"
        $policy = Read-JsonFile (Join-Path $sessionDirectory 'policy.json')
        if ($policy.decision -ne 'pass') { throw "Forbidden containment writes detected; see $reportPath" }
    }
    'report' {
        $sessionDirectory = Resolve-SessionDirectory $auditStateRoot
        $metadata = Read-JsonFile (Join-Path $sessionDirectory 'metadata.json')
        if ($metadata.status -ne 'stopped') { throw "Stop the audit before generating a report: $sessionDirectory" }
        $reportPath = New-Report $metadata (Read-DiffSet $sessionDirectory)
        Get-Content -LiteralPath $reportPath
    }
}
