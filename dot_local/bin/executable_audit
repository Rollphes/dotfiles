#!/bin/sh
set -eu

case "$(uname -s)" in
    MSYS_NT-*|MINGW*)
        ;;
    *)
        echo "This command is only available on Windows/MSYS2." >&2
        exit 1
        ;;
esac

if ! command -v pwsh.exe >/dev/null 2>&1; then
    echo "pwsh.exe is unavailable. Run chezmoi apply to converge managed tools." >&2
    exit 1
fi

implementation="$HOME/.local/bin/audit.ps1"
if [ ! -f "$implementation" ]; then
    echo "Audit implementation is missing: $implementation" >&2
    exit 1
fi

exec pwsh.exe -NoProfile -NonInteractive -File "$implementation" "$@"
