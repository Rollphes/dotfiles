{{- if eq .chezmoi.os "windows" }}
# Native profile resolvers must receive a Windows path even before native export.
export USERPROFILE="$(cygpath -w "$HOME")"
export APPDATA="$(cygpath -w "$HOME/AppData/Roaming")"
export LOCALAPPDATA="$(cygpath -w "$HOME/AppData/Local")"
export TEMP="$(cygpath -w /tmp)"
export TMP="$TEMP"
export GHQ_ROOT="$HOME/ghq"
export MISE_CONFIG_DIR="$XDG_CONFIG_HOME/mise"
export MISE_DATA_DIR="$XDG_DATA_HOME/mise"
export MISE_STATE_DIR="$XDG_STATE_HOME/mise"
export MISE_CACHE_DIR="$XDG_CACHE_HOME/mise"
export MISE_TMP_DIR="$XDG_CACHE_HOME/mise/tmp"
export AUBE_CACHE_DIR="$XDG_CACHE_HOME/aube"
export AUBE_STORE_DIR="$XDG_DATA_HOME/aube/store"
export ATUIN_CONFIG_DIR="$XDG_CONFIG_HOME/atuin"
export UV_CACHE_DIR="$XDG_CACHE_HOME/uv"
export UV_TOOL_DIR="$XDG_DATA_HOME/uv/tools"
export UV_PYTHON_INSTALL_DIR="$XDG_DATA_HOME/uv/python"
export _ZO_DATA_DIR="$XDG_DATA_HOME/zoxide"

msys2_export_native_environment() {
    export HOME="$(cygpath -m "$HOME")"
    export USERPROFILE="$(cygpath -w "$HOME")"
    export APPDATA="$(cygpath -m "$APPDATA")"
    export LOCALAPPDATA="$(cygpath -m "$LOCALAPPDATA")"
    export TEMP="$(cygpath -m "$TEMP")"
    export TMP="$(cygpath -m "$TMP")"
    export XDG_CONFIG_HOME="$(cygpath -m "$XDG_CONFIG_HOME")"
    export XDG_DATA_HOME="$(cygpath -m "$XDG_DATA_HOME")"
    export XDG_STATE_HOME="$(cygpath -m "$XDG_STATE_HOME")"
    export XDG_CACHE_HOME="$(cygpath -m "$XDG_CACHE_HOME")"
    export GHQ_ROOT="$(cygpath -m "$GHQ_ROOT")"
    export MISE_CONFIG_DIR="$(cygpath -m "$MISE_CONFIG_DIR")"
    export MISE_DATA_DIR="$(cygpath -m "$MISE_DATA_DIR")"
    export MISE_STATE_DIR="$(cygpath -m "$MISE_STATE_DIR")"
    export MISE_CACHE_DIR="$(cygpath -m "$MISE_CACHE_DIR")"
    export MISE_TMP_DIR="$(cygpath -m "$MISE_TMP_DIR")"
    export AUBE_CACHE_DIR="$(cygpath -m "$AUBE_CACHE_DIR")"
    export AUBE_STORE_DIR="$(cygpath -m "$AUBE_STORE_DIR")"
    export ATUIN_CONFIG_DIR="$(cygpath -m "$ATUIN_CONFIG_DIR")"
    export UV_CACHE_DIR="$(cygpath -m "$UV_CACHE_DIR")"
    export UV_TOOL_DIR="$(cygpath -m "$UV_TOOL_DIR")"
    export UV_PYTHON_INSTALL_DIR="$(cygpath -m "$UV_PYTHON_INSTALL_DIR")"
    export _ZO_DATA_DIR="$(cygpath -m "$_ZO_DATA_DIR")"
}
{{- end }}
