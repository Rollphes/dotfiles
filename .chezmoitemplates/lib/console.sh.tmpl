console_header() {
    component="$1"
    title="$2"

    printf '[%s] %s\n' "$component" "$title"
}

console_context() {
    printf '  %s\n' "$1"
    printf '\n'
}

console_status() {
    status="$1"
    resource="$2"
    kind="$3"
    detail="$4"

    printf '  %-7s %-20s [%-4s] %s\n' \
        "$status" "$resource" "$kind" "$detail"
}

console_detail() {
    label="$1"
    value="$2"

    printf '           %-9s %s\n' "$label:" "$value"
}

console_complete() {
    component="$1"
    summary="$2"

    printf '\n[%s] Complete: %s\n' "$component" "$summary"
}

console_failed() {
    component="$1"

    printf '\n[%s] Failed\n' "$component" >&2
}