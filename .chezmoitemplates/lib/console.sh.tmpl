console_header() {
    printf '[%s] %s\n' "$1" "$2"
}

console_context() {
    printf '  %s\n' "$1"
    printf '\n'
}

console_status() {
    printf '  %-7s %-20s [%-4s] %s\n' \
        "$1" "$2" "$3" "$4"
}

console_detail() {
    printf '           %-9s %s\n' "${1}:" "$2"
}

console_complete() {
    printf '\n[%s] Complete: %s\n' "$1" "$2"
}

console_failed() {
    printf '\n[%s] Failed\n' "$1" >&2
}
