# @param $1 Component name.
# @param $2 Header title.
console_header() {
    printf '[%s] %s\n' "$1" "$2"
}

# @param $1 Context text.
console_context() {
    printf '  %s\n' "$1"
    printf '\n'
}

# @param $1 Status label.
# @param $2 Resource name.
# @param $3 Resource kind.
# @param $4 Status detail.
console_status() {
    printf '  %-7s %-20s [%-4s] %s\n' \
        "$1" "$2" "$3" "$4"
}

# @param $1 Detail label.
# @param $2 Detail value.
console_detail() {
    printf '           %-9s %s\n' "${1}:" "$2"
}

# @param $1 Component name.
# @param $2 Completion summary.
console_complete() {
    printf '\n[%s] Complete: %s\n' "$1" "$2"
}

# @param $1 Component name.
console_failed() {
    printf '\n[%s] Failed\n' "$1" >&2
}
