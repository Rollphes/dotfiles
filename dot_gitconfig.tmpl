[user]
    useConfigOnly = true
    name = Rollphes
    email = 70063670+Rollphes@users.noreply.github.com

[core]
    autocrlf = input

[filter "lfs"]
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process

[init]
    defaultBranch = main

{{ if eq .chezmoi.os "windows" -}}
{{ $msysHome := .chezmoi.destDir | replace "C:/" "/c/" -}}
[http]
    sslBackend = openssl

[credential "https://github.com"]
    helper =
    helper = !PATH='{{ $msysHome }}/.local/bin':$PATH '{{ $msysHome }}/.local/share/mise/shims/gh.exe' auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !PATH='{{ $msysHome }}/.local/bin':$PATH '{{ $msysHome }}/.local/share/mise/shims/gh.exe' auth git-credential
{{ else -}}
[credential "https://github.com"]
    helper =
    helper = !'{{ .chezmoi.destDir }}/.local/share/mise/shims/gh' auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !'{{ .chezmoi.destDir }}/.local/share/mise/shims/gh' auth git-credential
{{ end -}}
